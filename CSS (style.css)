body {
    margin: 0;
    font-family: Arial;
    background-color: #f4f4f4;
}

/* HEADER */
header {
    background: #1e3a5f;
    color: white;
    padding: 20px;
    text-align: center;
}

/* NAV */
nav a {
    color: white;
    margin: 10px;
    text-decoration: none;
}

nav a:hover {
    color: yellow;
}

/* HERO */
.hero {
    text-align: center;
    background: #ddd;
    padding: 20px;
}

.hero img {
    width: 100%;
    max-height: 400px;
    object-fit: cover;
}

/* GRID */
.grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    padding: 20px;
}

/* CARD */
.card {
    background: white;
    padding: 15px;
    border-radius: 10px;
    box-shadow: 0 0 10px rgba(0,0,0,0.2);
    text-align: center;
}

.card img {
    width: 100%;
    border-radius: 10px;
}

/* FOOTER */
footer {
    background: #1e3a5f;
    color: white;
    text-align: center;
    padding: 15px;
}
